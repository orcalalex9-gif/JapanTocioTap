import asyncio
import logging
from aiogram import Bot, Dispatcher, types
from aiogram.filters import Command
from aiogram.enums import ParseMode
from aiogram.client.default import DefaultBotProperties

API_TOKEN = '8778491120:AAH8i-eqCEu8sD_N3CodImVe2LJxneNvrrs'

# ========== ПРОДАВЦЫ ==========
SELLER_SMIR = 8187401606
SELLER_SAKHAR = 8486571400
SELLER_OLEG = 8325915645
SELLER_IDS = [SELLER_SMIR, SELLER_SAKHAR, SELLER_OLEG]

logging.basicConfig(level=logging.INFO)
bot = Bot(token=API_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
dp = Dispatcher()

@dp.message(Command('start'))
async def start(message: types.Message):
    user_id = message.from_user.id
    
    if user_id in SELLER_IDS:
        await message.answer(
            f"✅ Ты продавец! Твой ID: {user_id}\n"
            f"Список продавцов: {SELLER_IDS}"
        )
    else:
        await message.answer(
            f"❌ Ты не продавец. Твой ID: {user_id}\n"
            f"Список продавцов: {SELLER_IDS}"
        )

@dp.message(Command('stats'))
async def stats(message: types.Message):
    user_id = message.from_user.id
    if user_id in SELLER_IDS:
        await message.answer(f"✅ Ты продавец! Список: {SELLER_IDS}")
    else:
        await message.answer(f"❌ Ты не продавец. Твой ID: {user_id}")

async def main():
    await dp.start_polling(bot)

if __name__ == '__main__':
    asyncio.run(main())
